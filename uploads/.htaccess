Options -Indexes

<FilesMatch "\.(?:php[0-9]?|phtml|phar|cgi|pl|py|sh|shtml|html?|svg)$">
    Require all denied
</FilesMatch>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Content-Disposition "inline"
</IfModule>